<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="28dp">

    <ImageView
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:contentDescription="@string/app_name"
        android:src="@drawable/ic_shield" />

    <TextView
        android:id="@+id/pinTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Enter your PIN"
        android:textColor="@color/text"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/pinSub"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="The PIN protects your block settings from being changed."
        android:textColor="@color/muted"
        android:textSize="14sp" />

    <EditText
        android:id="@+id/pinInput"
        style="@style/GuardInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="center"
        android:hint="PIN"
        android:importantForAutofill="no"
        android:inputType="numberPassword"
        android:letterSpacing="0.3"
        android:maxLength="12"
        android:maxLines="1" />

    <TextView
        android:id="@+id/pinError"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text=""
        android:textColor="@color/danger"
        android:textSize="13sp" />

    <Button
        android:id="@+id/pinConfirm"
        style="@style/GuardButton.Primary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="Unlock" />

    <Button
        android:id="@+id/pinCancel"
        style="@style/GuardButton.Secondary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Exit app" />
</LinearLayout>
